{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cogno.us/schemas/prp/reasoning-plan-v1.0.schema.json",
  "title": "PRP ReasoningPlan v1.0",
  "description": "Optional provider-neutral representation of PRP reasoning-allocation intent. It is advisory and does not establish authority, permission, execution, or observation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "level", "effort_band", "basis", "verification", "escalation"],
  "properties": {
    "protocol_version": {
      "const": "1.0"
    },
    "level": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "effort_band": {
      "type": "string",
      "enum": ["minimal", "low", "medium", "high", "maximum"]
    },
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "complexity",
        "ambiguity",
        "evidence_dependency",
        "consequence",
        "reversibility",
        "novelty",
        "authority_sensitivity"
      ],
      "properties": {
        "complexity": {"$ref": "#/$defs/band"},
        "ambiguity": {"$ref": "#/$defs/band"},
        "evidence_dependency": {"$ref": "#/$defs/band"},
        "consequence": {"$ref": "#/$defs/band"},
        "reversibility": {"$ref": "#/$defs/reversibility"},
        "novelty": {"$ref": "#/$defs/band"},
        "authority_sensitivity": {"$ref": "#/$defs/band"}
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required"],
      "properties": {
        "required": {"type": "boolean"},
        "reason": {"type": ["string", "null"]}
      }
    },
    "escalation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "triggers"],
      "properties": {
        "allowed": {"type": "boolean"},
        "triggers": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "unresolved_contradiction",
              "verification_failure",
              "required_evidence_missing",
              "schema_failure",
              "test_failure",
              "tool_result_conflict",
              "material_assumption",
              "authority_unresolved",
              "user_requested_deeper_analysis"
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "$defs": {
    "band": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "reversibility": {
      "type": "string",
      "enum": ["easy", "moderate", "difficult"]
    }
  }
}
